// Prisma schema for Foleio Platform
// This schema extends Supabase auth.users

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Users table (extends Supabase auth.users)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  phoneNumber   String?  @map("phone_number")
  countryCode   String   @default("NG") @map("country_code")
  isCreator     Boolean  @default(false) @map("is_creator")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  creatorProfile      Creator?
  fanSubscriptions    FanSubscription[] @relation("FanSubscriptions")
  transactions        Transaction[]
  usageRecords        UsageRecord[]
  uploads             Upload[]
  nudgeLogs           NudgeLog[]

  @@map("users")
  @@index([email])
}

// Creator Tier System
enum CreatorTier {
  TIER_1  // Selar Model (Bulk Transfers)
  TIER_2  // Hybrid (Choice)
  TIER_3  // Subaccount Required
}

enum SubaccountStatus {
  INACTIVE
  PENDING_CREATION
  ACTIVE
  SUSPENDED
}

enum PayoutMethod {
  SCHEDULED_BULK     // Free, weekly (Selar Model)
  INSTANT            // 1% fee (Selar Model)
  DIRECT_SUBACCOUNT  // Automatic via subaccount
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PayoutFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  MANUAL
}

// Creators table
model Creator {
  id       String @id @default(uuid())
  userId   String @unique @map("user_id")
  username String @unique
  displayName String @map("display_name")
  bio      String?
  category String  @default("makeup")
  avatarUrl String? @map("avatar_url")
  bannerUrl String? @map("banner_url")
  instagramHandle String? @map("instagram_handle")
  tiktokHandle    String? @map("tiktok_handle")

  // Intro video for public profile
  introVideoId String? @map("intro_video_id")

  // Platform subscription
  /// starter | pro | growth (legacy: premium → treated as growth)
  platformPlan              String?  @map("platform_plan") @default("starter")
  platformSubscriptionActive Boolean @default(false) @map("platform_subscription_active")
  platformSubscriptionEndsAt DateTime? @map("platform_subscription_ends_at")
  /// Admin-granted: creator may self-serve upgrade to Growth
  growthEligible            Boolean  @default(false) @map("growth_eligible")

  // HYBRID PAYMENT SYSTEM
  // Balance System (Selar Model)
  balance              BigInt @default(0) @map("balance")         // Available balance in kobo
  pendingBalance       BigInt @default(0) @map("pending_balance") // In holding period in kobo

  // Bank Details (Both Models)
  bankDetails          Json? @map("bank_details")                 // Basic bank info

  // Subaccount System (For TIER_3)
  paystackSubaccountCode String? @map("paystack_subaccount_code")
  subaccountStatus     SubaccountStatus @default(INACTIVE) @map("subaccount_status")

  // Recipient System (For TIER_1/2 Instant Payouts)
  paystackRecipientCode  String? @map("paystack_recipient_code")

  // Tier Management
  tier                CreatorTier @default(TIER_1) @map("tier")
  tierUpdatedAt       DateTime? @map("tier_updated_at")

  // Earnings Tracking (For Tier Calculations)
  totalEarnings       BigInt @default(0) @map("total_earnings") // in kobo
  monthlyEarnings     Json @default("{}") @map("monthly_earnings") // Last 12 months
  trustScore          Int @default(50) @map("trust_score") // 0-100
  chargebackRate      Decimal @default(0) @map("chargeback_rate")

  // Payout Settings
  payoutMethod        PayoutMethod @default(SCHEDULED_BULK) @map("payout_method")
  payoutThreshold     BigInt @default(250000) @map("payout_threshold") // ₦2,500 in kobo

  // Legacy fields (to be migrated)
  bankCode               String? @map("bank_code")
  accountNumber          String? @map("account_number")
  accountName            String? @map("account_name")
  bvnVerified            Boolean @default(false) @map("bvn_verified")
  identityVerifiedAt     DateTime? @map("identity_verified_at")
  availableBalance       Int @default(0) @map("available_balance") // in kobo
  totalEarned            Int @default(0) @map("total_earned") // in kobo lifetime
  currentBalance         BigInt @default(0) @map("current_balance") // Legacy

  // Stats
  subscriberCount Int    @default(0) @map("subscriber_count")
  contentCount    Int    @default(0) @map("content_count")

  // Settings
  isPublic  Boolean @default(true) @map("is_public")
  isBanned  Boolean @default(false) @map("is_banned")
  bannedAt  DateTime? @map("banned_at")
  banReason String? @map("ban_reason")
  journalBio String? @map("journal_bio")
  contentGuidelinesAccepted   Boolean  @default(false) @map("content_guidelines_accepted")
  contentGuidelinesAcceptedAt DateTime? @map("content_guidelines_accepted_at")
  hasSeenWelcome Boolean @default(false) @map("has_seen_welcome")
  hasCompletedOnboarding Boolean @default(false) @map("has_completed_onboarding")
  hasCompletedTour Boolean @default(false) @map("has_completed_tour")
  subscriptionEnabled Boolean @default(false) @map("subscription_enabled")
  reviewsEnabled Boolean @default(true) @map("reviews_enabled")
  /// Public fixed calendar bookings ("Book now" services)
  fixedBookingsEnabled Boolean @default(true) @map("fixed_bookings_enabled")
  /// Custom quote / negotiated engagements
  customQuotesEnabled Boolean @default(false) @map("custom_quotes_enabled")
  /// Public shop tab + shop management
  shopEnabled Boolean @default(true) @map("shop_enabled")
  /// Business WhatsApp for quote request/share (wa.me); digits with country code preferred
  quoteWhatsappPhone String? @map("quote_whatsapp_phone")
  monthlyPrice Int @default(0) @map("monthly_price")
  subscriptionPerks String[] @default([]) @map("subscription_perks")
  verified  Boolean @default(false)
  bankVerified Boolean @default(false) @map("bank_verified")

  // Booking deposit / cancellation policy (client money plan — not payout split)
  cancellationPolicy   Json @default("[{\"minDaysBefore\":60,\"maxDaysBefore\":null,\"refundPercent\":100},{\"minDaysBefore\":30,\"maxDaysBefore\":59,\"refundPercent\":50},{\"minDaysBefore\":0,\"maxDaysBefore\":29,\"refundPercent\":0}]") @map("cancellation_policy")
  balanceDueDaysBefore Int  @default(7) @map("balance_due_days_before")

  // Public booking policy document (PDF/DOC) or Google Doc link — one at a time
  bookingPolicyType     String? @map("booking_policy_type") // 'file' | 'link'
  bookingPolicyFileUrl  String? @map("booking_policy_file_url")
  bookingPolicyFileName String? @map("booking_policy_file_name")
  bookingPolicyLinkUrl  String? @map("booking_policy_link_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  introVideo        Content?          @relation("IntroVideo", fields: [introVideoId], references: [id])
  creatorPlans      CreatorPlan[]
  fanSubscriptions  FanSubscription[] @relation("CreatorSubscriptions")
  content           Content[]
  collections       Collection[]
  transactions      Transaction[]
  payouts           Payout[]
  platformSubscriptions PlatformSubscription[]
  creatorLinks      CreatorLink[]
  priceListItems    PriceListItem[]
  products          Product[]
  deliveryTiers     DeliveryTier[]
  orders            Order[]
  availability      CreatorAvailability[]
  availabilitySlots AvailabilitySlot[]
  availabilityTemplates AvailabilityTemplate[]
  bookings          Booking[]
  quoteRequests     QuoteRequest[]
  quotes            Quote[]
  emailSubscriptions EmailSubscription[]
  uploads           Upload[]
  milestoneLogs     MilestoneLog[]
  bankAccount       BankAccount?
  payoutSchedule    PayoutSchedule?
  journalEntries    JournalEntry[]
  portfolioSections PortfolioSection[]
  portfolioItems    PortfolioItem[]
  reviews           CreatorReview[]
  giftCards         GiftCard[]
  coupons           Coupon[]
  developerSupportGrants DeveloperSupportGrant[]

  @@map("creators")
  @@index([userId])
  @@index([username])
}

model JournalEntry {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  title       String
  subtitle    String?
  slug        String
  content     String
  coverImage  String?  @map("cover_image")
  tags        String[] @default([])
  readTime    Int      @default(1) @map("read_time")
  status      String   @default("draft")
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator     Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, slug])
  @@map("journal_entries")
  @@index([creatorId])
  @@index([isPublished])
  @@index([publishedAt])
}

// Creator subscription plans
model CreatorPlan {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  name        String
  description String?
  price       Int      // in kobo
  features    Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  creator        Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  fanSubscriptions FanSubscription[]

  @@map("creator_plans")
  @@index([creatorId])
}

// Fan subscriptions
model FanSubscription {
  id                    String   @id @default(uuid())
  fanId                 String   @map("fan_id")
  creatorId             String   @map("creator_id")
  planId                String?  @map("plan_id")

  // Subscription details
  status                String   @default("active") // active, canceled, past_due
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")
  cancelAtPeriodEnd     Boolean  @default(false) @map("cancel_at_period_end")

  // Payment details
  paystackSubscriptionId    String? @map("paystack_subscription_id")
  paystackAuthorizationCode String? @map("paystack_authorization_code")
  lastPaymentDate           DateTime? @map("last_payment_date")
  nextPaymentDate           DateTime? @map("next_payment_date")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  fan     User      @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creator Creator   @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)
  plan    CreatorPlan? @relation(fields: [planId], references: [id])

  @@unique([fanId, creatorId], name: "unique_active_subscription", map: "unique_fan_creator_active")
  @@map("fan_subscriptions")
  @@index([fanId])
  @@index([creatorId])
}

// Content
model Content {
  id            String   @id @default(uuid())
  creatorId     String   @map("creator_id")
  title         String
  description   String?
  type          String   // video, image, pdf, text
  thumbnailUrl  String?  @map("thumbnail_url")

  // Upload tracking
  uploadId      String?  @unique @map("upload_id") // Link to upload record

  // Video specific (Mux)
  muxAssetId    String?  @map("mux_asset_id") // Mux asset ID
  muxPlaybackId String?  @map("mux_playback_id") // Mux playback ID
  durationSeconds Int?   @map("duration_seconds")
  fileSizeBytes BigInt?  @map("file_size_bytes")

  // Access control
  accessType    String   @default("subscription") @map("access_type") // free, subscription, one_time
  requiredPlanId String? @map("required_plan_id")

  // Content category (content or tutorial)
  contentCategory String @default("content") @map("content_category") // content, tutorial

  // Tutorial-specific pricing (for individual purchase)
  tutorialPrice Int?     @map("tutorial_price") // in kobo, for individual tutorial purchase
  collectionId  String?  @map("collection_id") // Link tutorial to collection (optional)

  // Stats
  viewCount     Int      @default(0) @map("view_count")
  likeCount     Int      @default(0) @map("like_count")

  // Metadata
  isPublished   Boolean  @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  tags          String[] @default([])
  flaggedForReview Boolean @default(false) @map("flagged_for_review")
  flaggedReason String? @map("flagged_reason")
  flaggedAt DateTime? @map("flagged_at")
  moderationStatus String @default("pending") @map("moderation_status")
  moderationScore Float? @map("moderation_score")
  contentGuidelinesAccepted Boolean @default(false) @map("content_guidelines_accepted")
  isStandalone Boolean @default(false) @map("is_standalone")
  sectionId String? @map("section_id")
  sectionOrder Int @default(0) @map("section_order")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  creator          Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  collection       Collection?     @relation("TutorialContents", fields: [collectionId], references: [id])
  sectionContents  SectionContent[]
  introVideoFor    Creator[]       @relation("IntroVideo")
  premiumAccessCodes PremiumAccessCode[]
  tutorialPurchases TutorialPurchase[]
  reports           ContentReport[]
  upload           Upload?         @relation(fields: [uploadId], references: [id])

  @@map("content")
  @@index([creatorId])
  @@index([isPublished])
  @@index([contentCategory])
  @@index([collectionId])
}

model ContentReport {
  id            String   @id @default(cuid())
  contentId     String?  @map("content_id")
  content       Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reporterEmail String?  @map("reporter_email")
  reason        String
  details       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewedBy    String?  @map("reviewed_by")

  @@map("content_reports")
  @@index([contentId])
  @@index([status])
  @@index([reason])
}

// Collections (Courses/Playlists)
model Collection {
  id            String   @id @default(uuid())
  creatorId     String   @map("creator_id")
  title         String
  description   String?
  thumbnailUrl  String?  @map("thumbnail_url")
  
  // Access control
  accessType    String   @default("subscription") @map("access_type") // free, subscription, one_time
  requiredPlanId String? @map("required_plan_id")
  price         Int?     // in kobo (if one_time)
  
  // Subscription pricing (for collection subscriptions)
  subscriptionPrice Int?  @map("subscription_price") // Monthly recurring price in kobo
  subscriptionType  String? @default("one_time") @map("subscription_type") // one_time, recurring
  
  // Stats
  viewCount     Int      @default(0) @map("view_count")
  enrolledCount Int      @default(0) @map("enrolled_count")
  
  // Metadata
  isPublished   Boolean  @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  tags          String[] @default([])
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations
  creator        Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sections       Section[]
  tutorialContents Content[] @relation("TutorialContents") // Tutorials in this collection
  subscriptions  CollectionSubscription[]
  premiumAccessCodes PremiumAccessCode[]
  
  @@map("collections")
  @@index([creatorId])
  @@index([isPublished])
}

// Sections within Collections (supports nested subsections)
model Section {
  id            String   @id @default(uuid())
  collectionId  String   @map("collection_id")
  parentSectionId String? @map("parent_section_id") // For subsections
  title         String
  description   String?
  orderIndex    Int      @default(0) @map("order_index")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations
  collection     Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parentSection  Section?        @relation("SectionHierarchy", fields: [parentSectionId], references: [id], onDelete: Cascade)
  subsections    Section[]       @relation("SectionHierarchy")
  sectionContents SectionContent[]
  
  @@map("sections")
  @@index([collectionId])
  @@index([parentSectionId])
}

// Junction table: Links Content to Sections with ordering
model SectionContent {
  id        String   @id @default(uuid())
  sectionId String   @map("section_id")
  contentId String   @map("content_id")
  orderIndex Int     @default(0) @map("order_index")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  @@unique([sectionId, contentId])
  @@map("section_contents")
  @@index([sectionId])
  @@index([contentId])
}

// Payment Method Tracking
enum PaymentMethod {
  DIRECT_SUBACCOUNT  // TIER_3: Money split by Paystack
  PLATFORM_HELD      // TIER_1/2: Selar model, platform holds
}

// Transactions
model Transaction {
  id            String   @id @default(uuid())
  reference     String   @unique
  userId        String?  @map("user_id")
  creatorId     String?  @map("creator_id")

  // Amounts
  amount            BigInt   // in kobo (total paid by customer)
  creatorEarnings   BigInt?  @map("creator_earnings") // Amount going to creator
  platformFee       BigInt?  @map("platform_fee")     // Platform fee
  feeAmount         BigInt   @default(0) @map("fee_amount") // Gateway fees
  netAmount         BigInt   @default(0) @map("net_amount") // Legacy field
  currency          String   @default("NGN")

  // Status & Payment Method
  status            String   @default("pending") // pending, success, failed, refunded
  paymentMethod     String?  @map("payment_method") // card, bank_transfer, ussd
  paymentType       PaymentMethod? @map("payment_type") // DIRECT_SUBACCOUNT or PLATFORM_HELD
  gateway           String   @default("paystack")
  gatewayResponse   Json     @default("{}") @map("gateway_response")

  // Funds Management
  fundsReleased     Boolean  @default(false) @map("funds_released")
  fundsReleasedAt   DateTime? @map("funds_released_at")
  holdingDays       Int      @default(0) @map("holding_days")

  // Type & Metadata
  type          String   // subscription, one_time, payout, platform_fee
  metadata      Json     @default("{}")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user    User?    @relation(fields: [userId], references: [id])
  creator Creator? @relation(fields: [creatorId], references: [id])

  @@map("transactions")
  @@index([reference])
  @@index([userId])
  @@index([creatorId])
}

// Payouts
model Payout {
  id                  String   @id @default(uuid())
  creatorId           String   @map("creator_id")
  amount              Int      // in kobo
  status              String   @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED, REVERSED
  paystackTransferCode String? @map("paystack_transfer_code")
  paystackReference   String?  @unique @map("paystack_reference")
  reason              String?
  failureReason       String?  @map("failure_reason")
  scheduledFor        DateTime? @map("scheduled_for")
  transactionIds      String[] @default([]) @map("transaction_ids")
  metadata            Json     @default("{}")
  isManual            Boolean  @default(false) @map("is_manual")
  manualNote          String?  @map("manual_note")
  manualPaidAt        DateTime? @map("manual_paid_at")
  manualPaidBy        String?  @map("manual_paid_by")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("payouts")
  @@index([creatorId])
}

model BankAccount {
  id             String   @id @default(cuid())
  creatorId      String   @unique @map("creator_id")
  bankCode       String   @map("bank_code")
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  accountName    String   @map("account_name")
  recipientCode  String?  @map("recipient_code")
  isVerified     Boolean  @default(false) @map("is_verified")
  bvnVerified    Boolean  @default(false) @map("bvn_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model PayoutSchedule {
  id           String   @id @default(cuid())
  creatorId    String   @unique @map("creator_id")
  frequency    String
  isActive     Boolean  @default(true) @map("is_active")
  nextPayoutAt DateTime @map("next_payout_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("payout_schedules")
}

// Platform subscriptions (creators paying Foleio)
model PlatformSubscription {
  id                    String   @id @default(uuid())
  creatorId             String   @unique @map("creator_id")
  /// starter | pro | growth (legacy: premium)
  plan                  String
  amount                Int      // in kobo
  status                String   @default("active") // active, canceled, past_due, pending
  /// biannual | annual (null for legacy monthly)
  billingInterval       String?  @map("billing_interval")
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")
  trialEndsAt           DateTime? @map("trial_ends_at")
  cancelAtPeriodEnd     Boolean  @default(false) @map("cancel_at_period_end")
  paystackSubscriptionId String? @map("paystack_subscription_id")
  /// Paystack per-subscription email_token required to disable/enable the sub
  paystackEmailToken    String?  @map("paystack_email_token")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("platform_subscriptions")
  @@index([creatorId])
}

// Creator Links (Linktree-style links)
model CreatorLink {
  id        String   @id @default(uuid())
  creatorId String   @map("creator_id")
  label     String
  url       String
  linkType  String   @default("custom") @map("link_type") // instagram, tiktok, twitter, youtube, price_list, custom
  icon      String?
  orderIndex Int     @default(0) @map("order_index")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_links")
  @@index([creatorId])
  @@index([orderIndex])
}

// Price List Items for Booking Services
model PriceListItem {
  id               String   @id @default(uuid())
  creatorId        String   @map("creator_id")
  serviceType      String   @default("general") @map("service_type")
  category         String?  // Optional category/group name (e.g., "HOME SERVICE", "PHOTOSHOOT MAKEUP")
  name             String   // Item name (e.g., "MAINLAND 1", "ONE OUTFIT")
  description      String?  // Optional description/notes
  location         String?  // Place name or multi-location copy
  sessionDescription String? @map("session_description")
  calendlyLink     String?  @map("calendly_link")
  price            Int      // in kobo
  durationMinutes  Int?     @map("duration_minutes") // Estimated service duration
  addons           Json     @default("[]") // [{ id, name, price }] price in kobo
  locationOptions  Json     @default("[]") @map("location_options") // [{ id, name, price }] studio/area fees in kobo
  inclusions       Json     @default("[]") // string[] what's included in the package
  coverImageUrl    String?  @map("cover_image_url")
  // Client deposit (null depositType = full pay only, current behavior)
  depositType      String?  @map("deposit_type") // percent | fixed | null
  depositValue     Int?     @map("deposit_value") // percent 1-100, or kobo if fixed
  allowPayInFull   Boolean  @default(true) @map("allow_pay_in_full")
  /** Minimum days ahead a customer may book (null = no extra lead time). */
  minNoticeDays    Int?     @map("min_notice_days")
  /// fixed = calendar Book now; quote = Request a Quote intake
  pricingType      String   @default("fixed") @map("pricing_type") // fixed | quote
  orderIndex       Int      @default(0) @map("order_index") // Order within category
  categoryOrderIndex Int    @default(0) @map("category_order_index") // Order of categories
  isActive         Boolean  @default(true) @map("is_active")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  creator        Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  portfolioItems PortfolioItem[]
  quoteRequests  QuoteRequest[]
  quotes         Quote[]

  @@map("price_list_items")
  @@index([creatorId])
  @@index([category])
  @@index([orderIndex])
  @@index([isActive])
  @@index([pricingType])
}

// Shop products (physical)
model Product {
  id               String   @id @default(uuid())
  creatorId        String   @map("creator_id")
  name             String
  description      String?
  price            Int      // in kobo (charge / sale price)
  compareAtPrice   Int?     @map("compare_at_price") // original price in kobo; when > price shows discount
  discountStartsAt DateTime? @map("discount_starts_at")
  discountEndsAt   DateTime? @map("discount_ends_at")
  weight           Float?   // kg, for physical only
  type             String   @default("physical") // physical | digital | gift_card
  imageUrl         String?  @map("image_url") // primary / first image (compat)
  imageUrls        String[] @default([]) @map("image_urls") // Free up to 3, Pro up to 5
  digitalFileUrl   String?  @map("digital_file_url") // R2 object key for digital PDFs
  stock            Int?     // required for physical; null = unlimited for digital
  /** When true, public/manage cards show "Limited stock" instead of the count. */
  showLimitedStock Boolean  @default(false) @map("show_limited_stock")
  status           String   @default("draft") // draft | active
  orderIndex       Int      @default(0) @map("order_index")
  waiveDeliveryFee Boolean  @default(false) @map("waive_delivery_fee")
  /** Minimum units per add-to-cart / line. */
  minOrderQuantity Int      @default(1) @map("min_order_quantity")
  /** Fulfillment estimate only (no shop date picker). null/0 = ready now. */
  prepDaysMin      Int?     @map("prep_days_min")
  prepDaysMax      Int?     @map("prep_days_max")
  /** Needs extra logistics details at checkout (phone/notes). */
  requiresCustomDelivery Boolean @default(false) @map("requires_custom_delivery")
  isPreorder       Boolean  @default(false) @map("is_preorder")
  preorderSettings Json?    @map("preorder_settings") // { startsAt, releaseAt, preorderPrice, ... phases[] }
  addons           Json     @default("[]") // [{ id, name, required, options:[{ id, name, price, stock? }] }] price in kobo; stock null/omit = unlimited; legacy flat [{id,name,price}] still parsed
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  creator      Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@map("products")
  @@index([creatorId])
  @@index([status])
  @@index([creatorId, orderIndex])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String   // e.g. Size, Color, Scent
  options   String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
  @@index([productId])
}

model DeliveryTier {
  id               String   @id @default(uuid())
  creatorId        String   @map("creator_id")
  name             String
  description      String?
  type             String   @default("paid") // paid | free | pickup | customer_arranged
  flatRate         Int      @map("flat_rate") // in kobo; 0 for free/pickup
  /** Free delivery when cart subtotal (kobo) reaches this (Pro). */
  minSubtotalKobo  Int?     @map("min_subtotal_kobo")
  /** Free delivery when physical item quantity reaches this (Pro). */
  minItemQuantity  Int?     @map("min_item_quantity")
  estimatedDays    String?  @map("estimated_days") // unused in v1 UI
  /** Merchant phone for customer_arranged — shown on checkout, email, receipt. */
  contactPhone     String?  @map("contact_phone")
  createdAt        DateTime @default(now()) @map("created_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]
  quotes  Quote[]

  @@map("delivery_tiers")
  @@index([creatorId])
}

model Order {
  id                String   @id @default(uuid())
  fanId             String   @map("fan_id")
  creatorId         String   @map("creator_id")
  deliveryTierId    String?  @map("delivery_tier_id")
  deliveryAddress   Json     @map("delivery_address") // buyer + optional gift fields
  subtotal          Int      // in kobo
  deliveryFee       Int      @map("delivery_fee") // in kobo
  couponId          String?  @map("coupon_id")
  couponDiscountKobo Int     @default(0) @map("coupon_discount_kobo")
  giftCardId        String?  @map("gift_card_id")
  giftCardAppliedKobo Int    @default(0) @map("gift_card_applied_kobo")
  total             Int      // in kobo (after coupon + gift card credit)
  status            String   @default("pending")
  paystackReference String?  @map("paystack_reference")
  notes             String?
  /** Set when stock/coupon/gift-card side effects have been applied (idempotent). */
  inventoryAppliedAt DateTime? @map("inventory_applied_at")
  reviewToken       String?  @unique @map("review_token")
  reviewEmailSentAt DateTime? @map("review_email_sent_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  deliveryTier DeliveryTier? @relation(fields: [deliveryTierId], references: [id], onDelete: SetNull)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  giftCard     GiftCard?     @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  emailLogs    OrderEmailLog[]
  review       CreatorReview?
  quoteOrigin  Quote?        @relation("QuoteConvertedOrder")
  @@map("orders")
  @@index([fanId])
  @@index([creatorId])
  @@index([deliveryTierId])
  @@index([couponId])
  @@index([giftCardId])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String   @map("product_id")
  variantSelected Json?    @map("variant_selected")
  addonsSelected  Json?    @map("addons_selected") // [{ id, name, price }]
  quantity        Int      @default(1)
  unitPrice       Int      @map("unit_price") // in kobo at purchase time (base + addons)
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// Creator Availability (available dates for booking)
model CreatorAvailability {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  date        DateTime @db.Date // Available date (date only, no time)
  isAvailable Boolean  @default(true) @map("is_available")
  maxBookings Int?     @map("max_bookings") // Full-day capacity (forced to 1)
  mode        String   @default("full_day") // full_day | hours
  windowStart String?  @map("window_start") // HH:mm for hours mode generation
  windowEnd   String?  @map("window_end")
  slotIntervalMinutes Int @default(60) @map("slot_interval_minutes") // 60 | 90 for generated slots

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  creator Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slots   AvailabilitySlot[]

  @@unique([creatorId, date])
  @@map("creator_availability")
  @@index([creatorId])
  @@index([date])
}

// Bookable time slots for hours-mode availability days
model AvailabilitySlot {
  id             String   @id @default(uuid())
  creatorId      String   @map("creator_id")
  availabilityId String   @map("availability_id")
  date           DateTime @db.Date
  startTime      String   @map("start_time") // HH:mm
  endTime        String   @map("end_time") // HH:mm
  source         String   @default("generated") // generated | custom
  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator      Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  availability CreatorAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@unique([creatorId, date, startTime, endTime])
  @@map("availability_slots")
  @@index([creatorId, date])
  @@index([availabilityId])
  @@index([isActive])
}

// Reusable schedule templates for applying hours across dates
model AvailabilityTemplate {
  id                      String   @id @default(uuid())
  creatorId               String   @map("creator_id")
  name                    String
  mode                    String   @default("hours") // full_day | hours
  startTime               String?  @map("start_time") // HH:mm window start
  endTime                 String?  @map("end_time")
  slotIntervalMinutes     Int      @default(60) @map("slot_interval_minutes")
  customSlots             Json     @default("[]") @map("custom_slots") // [{ startTime, endTime }]
  disabledGeneratedStarts Json     @default("[]") @map("disabled_generated_starts") // string[] HH:mm

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("availability_templates")
  @@index([creatorId])
}

// Bookings for Creator Services
model Booking {
  id                String   @id @default(uuid())
  creatorId         String   @map("creator_id")
  priceListItemId   String   @map("price_list_item_id")

  // Customer details (no user account needed)
  customerEmail     String   @map("customer_email")
  customerName      String   @map("customer_name")
  customerPhone     String   @map("customer_phone") // Required for WhatsApp and calls
  customerAddress   String   @map("customer_address") // Service delivery address

  // Booking details
  bookingDate       DateTime @db.Date @map("booking_date") // Service date
  startTime         String?  @map("start_time") // HH:mm; null for full-day bookings
  endTime           String?  @map("end_time") // HH:mm; null for full-day bookings
  notes             String?  // Customer notes/requirements

  // Payment amounts (in kobo)
  totalAmount       Int      @map("total_amount") // Package + addons grand total
  firstPayoutAmount Int      @map("first_payout_amount") // Creator settlement split (not client deposit)
  secondPayoutAmount Int     @map("second_payout_amount")

  // Client payment plan (deposit vs full)
  paymentPlan       String   @default("full") @map("payment_plan") // full | deposit
  depositAmount     Int      @default(0) @map("deposit_amount")
  balanceAmount     Int      @default(0) @map("balance_amount")
  amountPaid        Int      @default(0) @map("amount_paid")
  selectedAddons    Json     @default("[]") @map("selected_addons") // [{ id, name, price }]
  selectedLocation  Json?    @map("selected_location") // { id, name, price } snapshot; null if service has no location options
  depositReference  String?  @map("deposit_reference")
  balanceReference  String?  @map("balance_reference")
  /// fixed | quote — quote-origin bookings skip slot capacity holds
  source            String   @default("fixed")
  /// [{ id, label, dueDate?, status: pending|done }] copied from Quote on convert
  milestones        Json     @default("[]")

  // Status tracking
  // pending | deposit_paid | balance_overdue | paid | first_payout_done | service_day | completed | disputed | refunded | cancelled
  status            String   @default("pending")
  paymentReference  String?  @map("payment_reference") // Latest successful Paystack reference
  trackingToken     String   @unique @map("tracking_token")
  reviewToken       String?  @unique @map("review_token")
  reviewEmailSentAt DateTime? @map("review_email_sent_at")
  quoteOrigin       Quote?   @relation("QuoteConvertedBooking")

  // Payout tracking
  firstPayoutTransactionId  String? @map("first_payout_transaction_id")
  secondPayoutTransactionId String? @map("second_payout_transaction_id")

  // Dispute handling
  disputeReason     String?  @map("dispute_reason")
  disputeStatus     String?  @map("dispute_status") // pending, approved, rejected
  refundTransactionId String? @map("refund_transaction_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  creator       Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  priceListItem PriceListItem @relation(fields: [priceListItemId], references: [id], onDelete: Cascade)
  emailLogs     BookingEmailLog[]
  review        CreatorReview?
  @@map("bookings")
  @@index([creatorId])
  @@index([customerEmail])
  @@index([bookingDate])
  @@index([creatorId, bookingDate, startTime])
  @@index([status])
}

/// Idempotent log for booking lifecycle emails (balance reminders, etc.)
model BookingEmailLog {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  emailType String   @map("email_type")
  sentAt    DateTime @default(now()) @map("sent_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, emailType])
  @@map("booking_email_logs")
  @@index([emailType])
}

/// Inbound custom quote intake from public profile
model QuoteRequest {
  id               String    @id @default(uuid())
  creatorId        String    @map("creator_id")
  linkedServiceId  String?   @map("linked_service_id")
  customerName     String    @map("customer_name")
  customerEmail    String    @map("customer_email")
  customerPhone    String    @map("customer_phone")
  preferredDate    DateTime? @map("preferred_date") @db.Date
  budgetMinKobo    Int?      @map("budget_min_kobo")
  budgetMaxKobo    Int?      @map("budget_max_kobo")
  brief            String
  status           String    @default("open") // open | quoted | closed
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  linkedService PriceListItem? @relation(fields: [linkedServiceId], references: [id], onDelete: SetNull)
  quotes        Quote[]

  @@map("quote_requests")
  @@index([creatorId])
  @@index([status])
  @@index([customerEmail])
}

/// Merchant-built custom quote; converts to Booking and/or Order on payment
model Quote {
  id                  String    @id @default(uuid())
  creatorId           String    @map("creator_id")
  quoteRequestId      String?   @map("quote_request_id")
  linkedServiceId     String?   @map("linked_service_id")
  supersedesQuoteId   String?   @map("supersedes_quote_id")
  customerName        String    @map("customer_name")
  customerEmail       String    @map("customer_email")
  customerPhone       String    @map("customer_phone")
  customerAddress     String    @default("") @map("customer_address")
  title               String
  lineItems           Json      @default("[]") @map("line_items") // [{ id, label, amountKobo, productId?, qty? }]
  totalAmount         Int       @map("total_amount") // kobo (line items + delivery)
  depositType         String?   @map("deposit_type") // percent | fixed | null = full
  depositValue        Int?      @map("deposit_value")
  depositAmount       Int       @default(0) @map("deposit_amount")
  balanceAmount       Int       @default(0) @map("balance_amount")
  milestones          Json      @default("[]") // [{ id, label, dueDate?, status }]
  serviceDate         DateTime? @map("service_date") @db.Date
  validUntil          DateTime? @map("valid_until")
  publicToken         String    @unique @map("public_token")
  status              String    @default("draft") // draft | sent | accepted | declined | expired | deposit_paid
  convertedBookingId  String?   @unique @map("converted_booking_id")
  convertedOrderId    String?   @unique @map("converted_order_id")
  deliveryTierId      String?   @map("delivery_tier_id")
  deliveryFeeKobo     Int       @default(0) @map("delivery_fee_kobo")
  /// none | tier | custom
  deliveryFeeMode     String    @default("none") @map("delivery_fee_mode")
  notes               String?
  paystackReference   String?   @map("paystack_reference")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  creator           Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  quoteRequest      QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  linkedService     PriceListItem? @relation(fields: [linkedServiceId], references: [id], onDelete: SetNull)
  deliveryTier      DeliveryTier?  @relation(fields: [deliveryTierId], references: [id], onDelete: SetNull)
  convertedBooking  Booking?       @relation("QuoteConvertedBooking", fields: [convertedBookingId], references: [id], onDelete: SetNull)
  convertedOrder    Order?         @relation("QuoteConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  emailLogs         QuoteEmailLog[]

  @@map("quotes")
  @@index([creatorId])
  @@index([status])
  @@index([quoteRequestId])
  @@index([customerEmail])
  @@index([validUntil])
  @@index([deliveryTierId])
}

model QuoteEmailLog {
  id        String   @id @default(cuid())
  quoteId   String   @map("quote_id")
  emailType String   @map("email_type")
  sentAt    DateTime @default(now()) @map("sent_at")
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, emailType])
  @@map("quote_email_logs")
  @@index([emailType])
}

/// Idempotent log for shop order lifecycle emails (abandoned checkout, etc.)
model OrderEmailLog {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  emailType String   @map("email_type")
  sentAt    DateTime @default(now()) @map("sent_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, emailType])
  @@map("order_email_logs")
  @@index([emailType])
}

// Creator-defined portfolio sections (industry-agnostic)
model PortfolioSection {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  name        String
  description String?
  orderIndex  Int      @default(0) @map("order_index")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items   PortfolioItem[]

  @@map("portfolio_sections")
  @@index([creatorId])
  @@index([orderIndex])
}

model PortfolioItem {
  id              String   @id @default(uuid())
  creatorId       String   @map("creator_id")
  sectionId       String   @map("section_id")
  imageUrl        String   @map("image_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  caption         String?
  orderIndex      Int      @default(0) @map("order_index")
  priceListItemId String?  @map("price_list_item_id")
  pairId          String?  @map("pair_id")
  pairRole        String?  @map("pair_role") // before | after
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  section       PortfolioSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  priceListItem PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)

  @@map("portfolio_items")
  @@index([creatorId])
  @@index([sectionId])
  @@index([priceListItemId])
  @@index([orderIndex])
}

/** Fan-submitted reviews (request email after booking complete / shop delivered). */
model CreatorReview {
  id           String   @id @default(uuid())
  creatorId    String   @map("creator_id")
  customerName String   @map("customer_name")
  location     String?
  quote        String
  rating       Int      @default(5) // 1–5
  bookingId    String?  @unique @map("booking_id")
  orderId      String?  @unique @map("order_id")
  orderIndex   Int      @default(0) @map("order_index")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("creator_reviews")
  @@index([creatorId])
  @@index([creatorId, orderIndex])
}

/** Merchant-granted developer setup access (no password sharing). */
model DeveloperSupportGrant {
  id          String    @id @default(uuid())
  creatorId   String    @map("creator_id")
  tokenHash   String    @map("token_hash")
  status      String    @default("pending") // pending | active | revoked | expired
  invitedEmail String?  @map("invited_email")
  requestedAt DateTime  @default(now()) @map("requested_at")
  acceptedAt  DateTime? @map("accepted_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([tokenHash])
  @@index([status])
  @@map("developer_support_grants")
}

/** Creator-scoped shop gift cards with reusable balance (Pro). */
model GiftCard {
  id               String    @id @default(uuid())
  creatorId        String    @map("creator_id")
  code             String
  faceValueKobo    Int       @map("face_value_kobo")
  balanceKobo      Int       @map("balance_kobo")
  status           String    @default("active") // active | depleted | void
  purchasedOrderId String?   @map("purchased_order_id")
  recipientEmail   String?   @map("recipient_email")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([creatorId, code])
  @@map("gift_cards")
  @@index([creatorId])
  @@index([code])
  @@index([status])
}

/** Creator-scoped shop coupon codes (Pro). Discount applies to product subtotal. */
model Coupon {
  id              String    @id @default(uuid())
  creatorId       String    @map("creator_id")
  code            String
  type            String // percent | fixed
  value           Int // percent points (1-100) OR fixed amount in kobo
  minSubtotalKobo Int?      @map("min_subtotal_kobo")
  maxUses         Int?      @map("max_uses")
  usedCount       Int       @default(0) @map("used_count")
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  status          String    @default("active") // active | disabled
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([creatorId, code])
  @@map("coupons")
  @@index([creatorId])
  @@index([code])
  @@index([status])
}

// Email Subscriptions (fans subscribing to creator updates)
model EmailSubscription {
  id               String   @id @default(uuid())
  creatorId        String   @map("creator_id")
  email            String
  isActive         Boolean  @default(true) @map("is_active")
  unsubscribeToken String   @unique @map("unsubscribe_token")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, email])
  @@map("email_subscriptions")
  @@index([creatorId])
  @@index([email])
}

// Premium Access Codes (for per-video/collection verification)
model PremiumAccessCode {
  id           String   @id @default(uuid())
  contentId    String?  @map("content_id") // For individual content access
  collectionId String?  @map("collection_id") // For collection access
  email        String
  code         String   // 6-digit code
  expiresAt    DateTime @map("expires_at") // 15 minutes from creation
  verified     Boolean  @default(false)
  verifiedAt   DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  content    Content?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("premium_access_codes")
  @@index([contentId])
  @@index([collectionId])
  @@index([email])
  @@index([expiresAt])
}

// Collection Subscriptions (email-based access to collections)
model CollectionSubscription {
  id               String    @id @default(uuid())
  collectionId     String    @map("collection_id")
  email            String
  subscriptionType String    @map("subscription_type") // one_time, recurring
  status           String    @default("active") // active, expired, cancelled
  paymentReference String?   @map("payment_reference")
  transactionId    String?   @map("transaction_id")
  expiresAt        DateTime? @map("expires_at") // For recurring, null = lifetime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, email])
  @@map("collection_subscriptions")
  @@index([collectionId])
  @@index([email])
  @@index([status])
}

// Tutorial Purchases (individual tutorial purchases by email)
model TutorialPurchase {
  id               String   @id @default(uuid())
  contentId        String   @map("content_id")
  email            String
  paymentReference String?  @map("payment_reference")
  transactionId    String?  @map("transaction_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, email])
  @@map("tutorial_purchases")
  @@index([contentId])
  @@index([email])
}

// Upload tracking for video processing
model Upload {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  creatorId     String    @map("creator_id")
  filename      String
  mimeType      String    @map("mime_type")
  size          BigInt    // File size in bytes
  status        UploadStatus @default(PENDING)
  muxUploadId   String?   @map("mux_upload_id") // Mux upload ID
  muxAssetId    String?   @map("mux_asset_id")
  muxPlaybackId String?   @map("mux_playback_id")
  url           String?   // Final playback URL
  error         String?   // Error message if failed
  metadata      Json?     // Additional processing data

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  content Content?

  @@map("uploads")
  @@index([userId, status])
  @@index([creatorId])
  @@index([status, createdAt])
}

enum UploadStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

// Usage tracking for cost monitoring and quotas
enum UsageType {
  UPLOAD
  STORAGE
  BANDWIDTH
  TRANSCODING
}

model UsageRecord {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      UsageType
  provider  String    // 'mux', 'r2', 'paystack', etc.
  amount    Float     // Amount used (GB, minutes, etc.)
  cost      Float     // Cost in USD
  metadata  Json?     // Additional data (file size, duration, etc.)

  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_records")
  @@index([userId, type, createdAt])
  @@index([createdAt])
}

model WaitlistEntry {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  status       String    @default("pending") // pending | approved | activated
  inviteToken  String?   @unique @map("invite_token")
  approvedAt   DateTime? @map("approved_at")
  activatedAt  DateTime? @map("activated_at")
  createdAt    DateTime  @default(now())

  @@map("waitlist_entries")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_settings")
}

model FanOTPCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fan_otp_codes")
  @@index([email, code, used])
  @@index([expiresAt])
}

/// Creator signup / email-verify OTP delivered via Resend (not Supabase templates).
model AuthOTPCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String   @default("signup") // signup | email_verify | invite
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_otp_codes")
  @@index([email, code, used])
  @@index([expiresAt])
}

model NudgeLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nudgeType String   @map("nudge_type")
  sentAt    DateTime @default(now()) @map("sent_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nudgeType])
  @@map("nudge_logs")
}

model MilestoneLog {
  id         String    @id @default(cuid())
  creatorId  String    @map("creator_id")
  milestone  String
  achievedAt DateTime  @default(now()) @map("achieved_at")
  seenAt     DateTime? @map("seen_at")
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, milestone])
  @@map("milestone_logs")
}

/// Platform operator accounts (separate from creator/fan User)
model AdminUser {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  totpSecretEnc      String?  @map("totp_secret_enc")
  totpEnabled        Boolean  @default(false) @map("totp_enabled")
  passwordMustChange Boolean  @default(true) @map("password_must_change")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
  @@index([email])
}

